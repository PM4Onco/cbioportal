From 1ad736db0900cc065fc4fc18e6b091592872d19a Mon Sep 17 00:00:00 2001
From: "AnhVu.Tran" <anhvu.tran@uksh.de>
Date: Thu, 12 Mar 2026 15:57:58 +0100
Subject: [PATCH] fix(build): add explicit mongo driver dependencies for
 release6.4.1

---
 pom.xml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/pom.xml b/pom.xml
index c9faf0cfb7..7636b2129b 100644
--- a/pom.xml
+++ b/pom.xml
@@ -334,6 +334,16 @@
       <artifactId>h2</artifactId>
       <scope>test</scope>
     </dependency>
+    <dependency>
+      <groupId>org.mongodb</groupId>
+      <artifactId>mongo-java-driver</artifactId>
+      <version>${mongo_java_driver.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>org.mongodb</groupId>
+      <artifactId>bson</artifactId>
+      <version>${mongodb_bson.version}</version>
+    </dependency>
     <dependency>
       <groupId>org.springframework.boot</groupId>
       <artifactId>spring-boot-starter-oauth2-client</artifactId>
-- 
2.52.0

